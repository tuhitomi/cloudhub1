{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "FrontendDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2",
          "PriceClass": "PriceClass_200",
          "Origins": [
            {
              "Id": "private-s3",
              "DomainName": {
                "Ref": "OriginDomain"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              }
            },
            {
              "Fn::If": [
                "HasUiContextOrigin",
                {
                  "Id": "ui-context-api",
                  "DomainName": {
                    "Ref": "UiApiOriginDomain"
                  },
                  "CustomOriginConfig": {
                    "OriginProtocolPolicy": "https-only",
                    "OriginSSLProtocols": [
                      "TLSv1.2"
                    ]
                  },
                  "OriginCustomHeaders": [
                    {
                      "HeaderName": "X-CloudHub-Edge-Key",
                      "HeaderValue": {
                        "Ref": "UiEdgeSecret"
                      }
                    }
                  ],
                  "OriginPath": {
                    "Ref": "UiApiOriginPath"
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "private-s3",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": {
              "Ref": "FrontendEdgeCachePolicy"
            },
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03"
          },
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "FrontendCertificateArn"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "CacheBehaviors": [
            {
              "TargetOriginId": "private-s3",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": true,
              "CachePolicyId": {
                "Ref": "FrontendEdgeCachePolicy"
              },
              "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
              "PathPattern": "index.html"
            },
            {
              "TargetOriginId": "private-s3",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": true,
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
              "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
              "PathPattern": "config.js"
            },
            {
              "Fn::If": [
                "HasUiContextOrigin",
                {
                  "PathPattern": "/ui-context",
                  "TargetOriginId": "ui-context-api",
                  "ViewerProtocolPolicy": "https-only",
                  "AllowedMethods": [
                    "GET",
                    "HEAD"
                  ],
                  "CachedMethods": [
                    "GET",
                    "HEAD"
                  ],
                  "Compress": true,
                  "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
                  "OriginRequestPolicyId": {
                    "Ref": "UiCountryOriginPolicy"
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ],
          "Aliases": [
            "app.example.com"
          ],
          "IPV6Enabled": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": "cloudhub-source-oac",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "UiCountryOriginPolicy": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Condition": "HasUiContextOrigin",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": "cloudhub-source-ui-country",
          "Comment": "Generated country only; no viewer Host, auth or cookies",
          "CookiesConfig": {
            "CookieBehavior": "none"
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "none"
          },
          "HeadersConfig": {
            "HeaderBehavior": "whitelist",
            "Headers": [
              "CloudFront-Viewer-Country"
            ]
          }
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "FrontendEdgeCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-frontend-edge"
          },
          "Comment": "CloudHub frontend: short edge TTL, gzip and brotli, no cookies/query/headers in key",
          "MinTTL": 60,
          "DefaultTTL": 60,
          "MaxTTL": 300,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    }
  },
  "Parameters": {
    "UiEdgeSecret": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 32,
      "MaxLength": 128,
      "AllowedPattern": "[A-Za-z0-9_-]{32,128}",
      "Description": "Random origin-only secret. Never include in public config or logs."
    },
    "UiApiOriginDomain": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(|[a-z0-9]+\\.execute-api\\.[a-z]{2}-[a-z]+-[0-9]\\.amazonaws\\.com)",
      "Description": "Existing API hostname from ApiUrl output. Set after initial creation to avoid Cognito/CloudFront dependency cycle."
    },
    "OriginDomain": {
      "Type": "String",
      "Description": "Explicit regional S3 REST endpoint; not a website endpoint"
    },
    "FrontendCertificateArn": {
      "Type": "String",
      "Description": "Issued ACM certificate in us-east-1"
    },
    "UiApiOriginPath": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(|/[A-Za-z0-9_-]+)",
      "Description": "Raw API stage path; empty for $default, independent of public API mapping"
    }
  },
  "Conditions": {
    "HasUiContextOrigin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "UiApiOriginDomain"
            },
            ""
          ]
        }
      ]
    }
  },
  "Outputs": {
    "DistributionId": {
      "Value": {
        "Ref": "FrontendDistribution"
      }
    },
    "DistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "FrontendDistribution",
          "DomainName"
        ]
      }
    }
  },
  "Description": "ILLUSTRATIVE ONLY: generate a native inventory and reviewed plan before deployment."
}
